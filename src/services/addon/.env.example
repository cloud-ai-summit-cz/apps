# Azure Authentication
AZURE_TENANT_ID=your-tenant-id
APP_ID_URI=api://addon-service
AZURE_CLIENT_ID=your-client-id  # Optional - for explicit identity selection

# Cosmos DB
COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_DATABASE_NAME=toytripdb
COSMOS_CONTAINER_NAME=addons

# Service Bus
SERVICE_BUS_NAMESPACE=your-namespace.servicebus.windows.net
SERVICE_BUS_QUEUE_NAME=addon-fulfill

# Inter-service Communication
TRIP_SERVICE_URL=http://trip-service:8002
TOY_SERVICE_URL=http://toy-service:8001
DEMO_MEDIA_SERVICE_URL=http://demo-media-service:8005

# Blob Storage
STORAGE_ACCOUNT_URL=https://yourstorageaccount.blob.core.windows.net
BLOB_CONTAINER_FULFILLMENT=fulfillment

# API Configuration
API_HOST=0.0.0.0
API_PORT=8003
LOG_LEVEL=INFO

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=addon-service
SERVICE_VERSION=1.0.0
K8S_NAMESPACE=
K8S_POD_NAME=
K8S_NODE_NAME=
