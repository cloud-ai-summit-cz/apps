# Azure Authentication
AZURE_TENANT_ID=your-tenant-id
APP_ID_URI=api://story-service
AZURE_CLIENT_ID=your-managed-identity-client-id

# Cosmos DB
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DATABASE_NAME=toytripdb
COSMOS_CONTAINER_NAME=stories

# Azure Service Bus
SERVICE_BUS_NAMESPACE=your-namespace.servicebus.windows.net
STORY_JOBS_QUEUE_NAME=story-jobs

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Inter-service Communication
TRIP_SERVICE_URL=http://trip-service:8002
TOY_SERVICE_URL=http://toy-service:8001
GEO_SERVICE_URL=http://geo-service:8003

# API Configuration
API_HOST=0.0.0.0
API_PORT=8004
LOG_LEVEL=INFO

# Worker Configuration (for worker mode)
WORKER_MODE=false
MAX_CONCURRENT_MESSAGES=5

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=story-service
SERVICE_VERSION=1.0.0

# Kubernetes (auto-populated in k8s)
K8S_NAMESPACE=
K8S_POD_NAME=
K8S_NODE_NAME=
