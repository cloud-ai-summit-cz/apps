# Azure Authentication (from app registration)
AZURE_TENANT_ID=your-tenant-id
APP_ID_URI=api://your-app-id

# Cosmos DB
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DATABASE_NAME=toytripdb
COSMOS_CONTAINER_NAME=trips

# Blob Storage
STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
BLOB_CONTAINER_GALLERY=gallery

# Inter-service Communication
TOY_SERVICE_URL=http://localhost:8001

# API Configuration
API_HOST=0.0.0.0
API_PORT=8002
LOG_LEVEL=INFO

# OpenTelemetry Configuration
# OTLP Collector endpoint (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=trip-service
SERVICE_VERSION=1.0.0

# Kubernetes Context (auto-injected in K8s via downward API)
# K8S_NAMESPACE=default
# K8S_POD_NAME=trip-deployment-abc123
# K8S_NODE_NAME=aks-nodepool-12345
